// Case sensitivity ^
// in, _cs & =~

// Detailed role assignments for workload identities

// Regex to find assignments on subscriptions

// See permissions of roles

// VM with NIC join

// --- Tips & tricks ---

// Default table

// Hidden properties and api version

// Shared queries

// Parse scope of role assignment
authorizationresources
| where type =~ 'microsoft.authorization/roleassignments' and id contains 'Microsoft.Storage/storageAccounts'
| parse properties.scope with '/subscriptions/' * 'Microsoft.Storage/storageAccounts/' resourceScope
| project resourceScope
